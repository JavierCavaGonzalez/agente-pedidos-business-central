# Copia este archivo a .env y rellena lo que uses. .env está en .gitignore: nunca subas credenciales.

# ---- Modelo de lenguaje ----------------------------------------------------------
# simulado (por defecto, sin red) | openai | azure_openai | foundry
MODELO_PROVEEDOR=simulado

# MODELO_PROVEEDOR=openai
OPENAI_API_KEY=
# Un modelo que admita temperature: el código la fija y los modelos razonadores (serie gpt-5) no la admiten
OPENAI_CHAT_MODEL=gpt-4.1-mini

# MODELO_PROVEEDOR=azure_openai  (con clave o, si se deja vacía, con DefaultAzureCredential)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_MODEL=
AZURE_OPENAI_API_VERSION=

# MODELO_PROVEEDOR=foundry  (requiere azure-identity y `az login`)
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=

# ---- Business Central ------------------------------------------------------------
# demo (por defecto, datos simulados en memoria) | api (sandbox real por API v2.0)
BC_MODO=demo
BC_TENANT_ID=
BC_ENVIRONMENT=Sandbox
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_COMPANY_NAME=CRONUS ES
BC_COMPANY_ID=

# ---- Política de aprobación (la decide el código, no el modelo) ------------------
POLITICA_UMBRAL_APROBACION=3000
POLITICA_APROBAR_SIEMPRE=0
POLITICA_PERMITIR_SIN_EXISTENCIAS=0
POLITICA_MAX_LINEAS=20
POLITICA_CLIENTES_VETADOS=

# ---- Controles en tiempo de ejecución --------------------------------------------
# Los comentarios van siempre en su propia línea, nunca detrás de un valor.
# 1 = el middleware bloquea toda herramienta de escritura
AGENTE_SOLO_LECTURA=0
# tope de llamadas al modelo por ejecución
AGENTE_MAX_LLAMADAS_MODELO=12
# registro de cada herramienta ejecutada
AGENTE_AUDITORIA=auditoria.jsonl
# carpeta donde se guardan las ejecuciones en espera de aprobación
AGENTE_CHECKPOINTS=checkpoints

# ---- Observabilidad y coste ------------------------------------------------------
# p. ej. Aspire Dashboard:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# trazas por consola:
# ENABLE_CONSOLE_EXPORTERS=1
# 1 incluye el contenido de los mensajes (nunca en producción):
# ENABLE_SENSITIVE_DATA=0
# Azure Monitor (requiere azure-monitor-opentelemetry):
# APPLICATIONINSIGHTS_CONNECTION_STRING=
PRECIO_ENTRADA_EUR_POR_MILLON=2.0
PRECIO_SALIDA_EUR_POR_MILLON=8.0
